    "plt.ylabel('Nombre d\\'usagers', fontsize=12)\n",
    "\n",
    "# Ajout des valeurs au-dessus des barres pour plus de précision\n",
    "for p in ax.patches:\n",
    "    ax.annotate(f'{int(p.get_height()):,}', \n",
